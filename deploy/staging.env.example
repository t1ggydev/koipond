# ISOLATED STAGING ONLY. Never enter production database credentials here.
# Copy to staging.env; that filename is ignored by Git and Docker build context.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=https://isolated-supabase.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-isolated-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-isolated-staging-service-role-key
SESSION_SECRET=replace-with-independent-staging-session-secret
ENABLE_DEMO=false
TWITCH_CLIENT_ID=replace-with-test-application-client-id
TWITCH_CLIENT_SECRET=replace-with-test-application-secret
TWITCH_BOT_USER_ID=replace-with-test-bot-user-id
TWITCH_EVENTSUB_SECRET=replace-with-independent-test-webhook-secret
ALLOWED_STREAMER_TWITCH_IDS=replace-with-test-channel-id
EVENTSUB_PUBLIC_URL=
OSU_CLIENT_ID=replace-with-test-client-id
OSU_CLIENT_SECRET=replace-with-test-client-secret
CRON_SECRET=replace-with-independent-staging-cron-secret
# Runtime only. Minimum 32 characters. Never set a NEXT_PUBLIC monitoring token.
KOIPOND_MONITORING_TOKEN=replace-with-independent-staging-monitoring-token
# Optional readiness probe target for an isolated internal Supabase gateway.
SUPABASE_INTERNAL_URL=

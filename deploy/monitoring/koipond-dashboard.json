{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Bestehendes Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "koipond-staging",
  "title": "Koipond · Staging",
  "tags": [
    "koipond",
    "staging",
    "preparation"
  ],
  "description": "Vorbereiteter Import für die bestehende Monitoring-Plattform; globale DB-Zähler niemals über Instanzen summieren. Keine Konfiguration ist damit bereits produktiv angewendet.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "refresh": 1,
        "query": {
          "query": "label_values(koipond_process_uptime_seconds, job)",
          "refId": "job"
        },
        "current": {
          "text": "koipond-staging",
          "value": "koipond-staging",
          "selected": true
        },
        "options": [
          {
            "text": "koipond-staging",
            "value": "koipond-staging",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false,
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instanz",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(koipond_process_uptime_seconds{job=~\"${job:regex}\"}, instance)",
          "refId": "instance"
        },
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Vorbereitung – noch nicht installiert",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Erst nach Bereitstellung des privaten Staging-Endpunkts importieren und anwenden. **Globale Datenbankmetriken werden mit `max()` statt `sum()` über Instanzen ausgewertet.** Der Instanzfilter gilt für HTTP/Prozessmetriken; globale Werte gelten für den gesamten gewählten Job. Aktive Nutzer: eindeutige angemeldete Nutzer im 5-Minuten-Fenster, keine Twitch-Zuschauerzählung. Fehlende Messungen bleiben sichtbar und werden nicht als künstliche Nutzer-/Zähler-Nullwerte ersetzt."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / Sekunde",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(koipond_http_requests_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP 5xx-Quote",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(koipond_http_requests_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\",status=~\"5..\"}[$__rate_interval]))) or (0 * sum(rate(koipond_http_requests_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))) / clamp_min(sum(rate(koipond_http_requests_total{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])), 1e-9)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
